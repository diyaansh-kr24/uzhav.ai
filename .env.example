# Copy to .env in this directory. Never put provider keys in frontend variables.
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_API_KEY=
AICREDITS_MODEL=deepseek/deepseek-v3.2
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saaras:v3
# Set a random secret for the reviewer screen. Empty means review access is disabled.
REVIEWER_TOKEN=
# Optional dense retrieval. Run scripts/embed.py after setting this to build the index.
EMBEDDING_MODEL=
DATABASE_PATH=
